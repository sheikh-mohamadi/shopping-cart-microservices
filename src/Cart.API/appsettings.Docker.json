{
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "Topics": ["cart-events"],
    "GroupId": "cart-api-group"
  },
  "Redis": {
    "ConnectionString": "redis:6379"
  },
  "ConnectionStrings": {
    "EventStore": "Host=postgres;Database=shopping_cart;Username=postgres;Password=${POSTGRES_PASSWORD}"
  },
  "Jwt": {
    "Key": "-",
    "Issuer": "ShoppingCartAPI",
    "Audience": "ShoppingCartAPI",
    "DurationInMinutes": 60
  }
}